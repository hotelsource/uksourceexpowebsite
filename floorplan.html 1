function setCat(btn, cat) {
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('cat-active'));
  btn.classList.add('cat-active');
  const stalls = document.querySelectorAll('.stall');
  if(cat === 'all') {
    stalls.forEach(s => s.style.opacity = '1');
    return;
  }
  const targets = catMap[cat] || [];
  stalls.forEach(s => {
    s.style.opacity = targets.includes(s.dataset.id) ? '1' : '0.2';
  });
  // Show info
  if(targets.length) {
    const avail = targets.filter(id => !stallData[id] || stallData[id].status === 'avail').length;
    console.log(`${cat}: ${avail} available stalls`);
  }
}

// Filter
function filterStalls(type) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  document.querySelectorAll('.stall').forEach(s => {
    const st = s.dataset.status;
    if(type === 'all') { s.style.opacity = '1'; return; }
    if(type === 'avail') { s.style.opacity = (st==='avail'||st==='interested') ? '1' : '0.18'; return; }
    if(type === 'booked') { s.style.opacity = st==='booked' ? '1' : '0.18'; return; }
    if(type === 'reserved') { s.style.opacity = st==='reserved' ? '1' : '0.18'; return; }
  });
}

// ── DYNAMIC SCARCITY COUNTER ──
(function() {
  // Base: 14 booked, 62 avail (total 100, 19 reserved, 5 interested)
  // Each session: randomise within ±6 of base available
  const BASE_BOOKED = 22;
  const BASE_AVAIL  = 64;
  const VARIANCE    = 5;

  // Seed from date so it changes daily but stays consistent within a day
  // Plus a small session random within ±3
  const today = new Date();
  const daySeed = today.getDate() + today.getMonth() * 31;
  const dailyShift = (daySeed % 7) - 3; // -3 to +3 based on date
  const sessionShift = Math.floor(Math.random() * VARIANCE) - Math.floor(VARIANCE / 2); // -3 to +3

  const totalShift = Math.max(-6, Math.min(6, dailyShift + sessionShift));

  const dispAvail  = BASE_AVAIL  - totalShift;
  const dispBooked = BASE_BOOKED + totalShift;

  // Animate count-up on load
  function animateCount(el, target, duration) {
    if (!el) return;
    const start = 0;
    const step = target / (duration / 16);
    let current = start;
    const timer = setInterval(() => {
      current = Math.min(current + step, target);
      el.textContent = Math.round(current);
      if (current >= target) clearInterval(timer);
    }, 16);
  }

  window.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      animateCount(document.getElementById('avail-count'),  dispAvail,  800);
      animateCount(document.getElementById('booked-count'), dispBooked, 600);
      try{var la=document.getElementById('legend-avail');if(la)la.textContent=dispAvail;}catch(e){}
      try{var lb=document.getElementById('legend-booked');if(lb)lb.textContent=dispBooked;}catch(e){}
      try{var lr=document.getElementById('reserved-count');if(lr)lr.textContent=14;}catch(e){}
    }, 300);
  });
})();

